# Copy this file to .env in this folder, then fill in JWT_SECRET.

# The port the API listens on. Docker Compose and the frontend's dev server read it too.
PORT=5001

# The database the API uses when it runs without Docker. Docker Compose sets its own.
MONGODB_URI=mongodb://localhost:27017/TestDB

# Required: the API won't start without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a login lasts. Include the unit: 15m, 1h, or 7d. A bare number means milliseconds.
JWT_EXPIRES_IN=1h
